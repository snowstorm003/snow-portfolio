---
import Base from '../../layouts/Base.astro';
import LiteYouTube from '../../components/LiteYouTube.astro';
import { getAllProjects, fieldNotes, noteNumber, markTodos, type Project } from '../../lib/projects';

export async function getStaticPaths() {
  const all = await getAllProjects();
  return all.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      index: i,
      total: all.length,
      prev: all[(i - 1 + all.length) % all.length],
      next: all[(i + 1) % all.length],
    },
  }));
}

interface Props { project: Project; index: number; total: number; prev: Project; next: Project; }
const { project, index, total, prev, next } = Astro.props;
const d = project.data;
const notes = fieldNotes(project);
const pad = (n: number) => String(n).padStart(2, '0');
const isVideo = d.kind === 'Video';

const sheet = [
  { label: 'Production', value: d.title },
  { label: 'Year', value: d.year },
  { label: 'Format', value: d.format },
  { label: 'Role', value: d.role },
  { label: 'Scale', value: d.scale },
].filter((c) => c.value);
---
<Base title={`${d.title} — Snow, ${'Operations & Project Manager'}`} description={d.summary.replace(/\s*\[TODO:[^\]]*\]/g, '')}>
  <article>
    <header class="wrap intro">
      <dl class="sheet mono">
        {sheet.map((c) => (
          <div class="sheet-cell"><dt>{c.label}</dt><dd set:html={markTodos(c.value)} /></div>
        ))}
        <div class="sheet-cell"><dt>Project</dt><dd class="accent">{pad(index + 1)} / {pad(total)}</dd></div>
      </dl>

      {d.status && <p class="mono status"><span class="dot" aria-hidden="true"></span>{d.status}</p>}
      <h1 class="display title">{d.title}</h1>
      <p class="summary" set:html={markTodos(d.summary)} />
    </header>

    <section class="wrap media-wrap" aria-label={isVideo ? 'Final film' : 'Main image'}>
      {d.youtubeId ? (
        <div class="media media--ink">
          <LiteYouTube id={d.youtubeId} title={`${d.title} — final cut`} />
          <span class="mono media-label"><span class="dot" aria-hidden="true"></span>Final cut</span>
        </div>
      ) : d.heroImage ? (
        <div class="media">
          <img src={d.heroImage} alt={d.heroAlt || d.title} width="1600" height="900" decoding="async" />
        </div>
      ) : isVideo ? (
        <div class="media media--ink media--ph">
          <span class="mono media-label"><span class="dot" aria-hidden="true"></span>Final cut</span>
          <svg width="64" height="64" viewBox="0 0 64 64" fill="none" aria-hidden="true"><circle cx="32" cy="32" r="31" stroke="currentColor" stroke-width="1.5" /><path d="M26 21 L44 32 L26 43 Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /></svg>
          <span class="mono ph-text">[TODO: YouTube ID — published final cut]</span>
        </div>
      ) : (
        <div class="media media--stock media--ph">
          <span class="mono ph-text">[TODO: {d.placeholder || 'hero image'}]</span>
        </div>
      )}
    </section>

    {notes.length > 0 && (
      <section class="wrap notes" aria-label="Field notes">
        {notes.map((n) => (
          <div class="note">
            <h2 class:list={['mono', 'note-label', { 'note-label--wrong': n.id === 'what-went-wrong' }]}>{noteNumber(n.id)} — {n.label}</h2>
            <div class="note-body" set:html={n.html} />
          </div>
        ))}
      </section>
    )}

    {d.stills.length > 0 && (
      <section class="wrap stills" aria-label="Stills">
        {d.stills.map((s) => (
          <img src={s.src} alt={s.alt} width="800" height="600" loading="lazy" decoding="async" />
        ))}
      </section>
    )}

    {(d.numbers.length > 0 || d.credits.length > 0) && (
      <section class="band">
        <div class="wrap band-grid">
          {d.numbers.length > 0 && (
            <div>
              <h2 class="mono band-label">On the sheet</h2>
              <dl class="numbers">
                {d.numbers.map((n) => (
                  <div><dt class="mono">{n.label}</dt><dd class="number">{n.value}</dd></div>
                ))}
              </dl>
            </div>
          )}
          {d.credits.length > 0 && (
            <div>
              <h2 class="mono band-label">Credits</h2>
              <dl class="credits mono">
                {d.credits.map((c) => (
                  <div class="credit-row"><dt>{c.role}</dt><dd set:html={markTodos(c.name)} /></div>
                ))}
              </dl>
            </div>
          )}
        </div>
      </section>
    )}

    <nav class="wrap pager" aria-label="More projects">
      <a href={`/work/${prev.id}`} class="pager-link" rel="prev">
        <span class="mono">← Previous</span><span class="pager-title">{prev.data.title}</span>
      </a>
      <a href={`/work/${next.id}`} class="pager-link pager-link--next" rel="next">
        <span class="mono">Next →</span><span class="pager-title">{next.data.title}</span>
      </a>
    </nav>
  </article>
</Base>

<style>
  .intro { padding-top: 32px; padding-bottom: 48px; }

  /* Call-sheet strip */
  .sheet {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    margin: 0;
    border-block: 1px solid var(--ink);
    color: var(--ink);
  }
  .sheet-cell { padding: 14px 16px; border-right: 1px solid var(--rule-light); min-width: 0; }
  .sheet-cell:first-child { padding-left: 0; }
  .sheet-cell:last-child { border-right: none; }
  .sheet dt { color: var(--graphite); margin-bottom: 6px; }
  .sheet dd { margin: 0; overflow-wrap: anywhere; }
  .sheet .accent { color: var(--accent); font-weight: 500; }

  .status { display: flex; align-items: center; gap: 10px; margin: 40px 0 0; color: var(--ink); }
  .title {
    margin-top: 40px;
    font-size: clamp(56px, 9vw, 140px);
    overflow-wrap: break-word;
    hyphens: auto;
  }
  .status + .title { margin-top: 16px; }
  .summary { margin: 28px 0 0; font-size: 24px; line-height: 1.45; max-width: 40ch; }

  /* Main media */
  .media-wrap { padding-bottom: 88px; }
  .media { position: relative; aspect-ratio: 16 / 9; background: var(--stock); overflow: hidden; }
  .media > img { width: 100%; height: 100%; object-fit: cover; }
  .media--ink { background: var(--ink); color: var(--paper); }
  .media--stock { border: 1px solid var(--ink); }
  .media--ph { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px; padding: 20px; text-align: center; }
  .media-label {
    position: absolute;
    top: 20px;
    left: 24px;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--paper);
    pointer-events: none;
  }
  .media--ink .ph-text { color: var(--label-ink); }

  /* Field notes */
  .notes { padding-bottom: 40px; }
  .note {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 40px;
    padding: 40px 0;
    border-top: 1px solid var(--ink);
  }
  .note-label { margin: 0; font-weight: 500; padding-top: 6px; }
  .note-label--wrong { color: var(--accent); }
  .note-body { max-width: 60ch; }
  .note-body :global(p) { margin: 0 0 16px; font-size: 21px; line-height: 1.55; }
  .note-body :global(p:last-child) { margin-bottom: 0; }
  :global(.todo-mark) { color: var(--graphite); }

  /* Stills */
  .stills {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 16px;
    padding-bottom: 88px;
  }
  .stills img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; background: var(--stock); border: 1px solid var(--ink); }

  /* Ink band */
  .band { background: var(--ink); color: var(--paper); padding: 80px 0; }
  .band-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 56px; }
  .band .mono { color: var(--label-ink); }
  .band-label { margin: 0 0 24px; font-weight: 500; }
  .numbers { margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 24px; }
  .number { margin: 6px 0 0; font-weight: 800; font-stretch: 70%; font-size: 56px; line-height: 1; text-transform: uppercase; overflow-wrap: anywhere; }
  .credits { margin: 0; border-top: 1px solid var(--soft-ink); }
  .credit-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 16px; border-bottom: 1px solid var(--soft-ink); }
  .credit-row dt { padding: 12px 0; }
  .credit-row dd { margin: 0; padding: 12px 0; color: var(--paper); }
  .band :global(.todo-mark) { color: var(--label-ink); }

  /* Previous / next */
  .pager { display: flex; justify-content: space-between; gap: 24px; flex-wrap: wrap; padding-top: 48px; padding-bottom: 64px; }
  .pager-link { display: flex; flex-direction: column; gap: 8px; text-decoration: none; max-width: 48%; min-height: 44px; }
  .pager-link--next { text-align: right; margin-left: auto; }
  .pager-title { font-weight: 800; font-stretch: 75%; font-size: 28px; line-height: 1.05; text-transform: uppercase; }
  .pager-link:hover .pager-title { color: var(--accent); }

  @media (max-width: 820px) {
    .sheet { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .sheet-cell { padding: 12px 12px 12px 0; border-right: none; border-bottom: 1px solid var(--rule-light); }
    .sheet-cell:nth-last-child(-n+2) { border-bottom: none; }
    .sheet-cell:nth-child(odd):last-child { grid-column: 1 / -1; }
    .summary { font-size: 21px; }
    .media-wrap { padding-bottom: 56px; }
    .note { grid-template-columns: minmax(0, 1fr); gap: 14px; padding: 32px 0; }
    .note-body :global(p) { font-size: 19px; }
    .band { padding: 64px 0; }
    .number { font-size: 44px; }
    .pager-link { max-width: 100%; flex-basis: 100%; }
  }
  @media (max-width: 480px) {
    .title { font-size: clamp(40px, 13vw, 56px); }
  }
</style>
