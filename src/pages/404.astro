---
import Base from '../layouts/Base.astro';
---
<Base title="Missed the call time — Snow" description="This page doesn’t exist. Head back to the main set." noindex>
  <section class="wrap lost">
    <p class="mono">Error 404 · Scene not found</p>
    <h1 class="display title">Missed the<br />call time.</h1>
    <p class="body-text">This page isn’t on today’s sheet. It may have moved, or it never existed.</p>
    <div class="actions">
      <a href="/" class="btn btn--ink mono"><span class="dot" aria-hidden="true"></span>Back to home</a>
      <a href="/work" class="btn btn--outline mono">All work →</a>
    </div>
  </section>
</Base>

<style>
  .lost { padding-top: 64px; padding-bottom: 120px; }
  .title { margin-top: 20px; font-size: clamp(56px, 10vw, 150px); line-height: .86; }
  .body-text { margin: 32px 0 0; color: var(--soft-ink); }
  .actions { display: flex; flex-wrap: wrap; gap: 12px 16px; margin-top: 40px; }
  .actions .btn--ink { color: var(--paper); }
</style>
