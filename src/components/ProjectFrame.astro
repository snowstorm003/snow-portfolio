---
import { thumbnailFor, filterValue, type Project } from '../lib/projects';

interface Props { project: Project; variant?: 'strip' | 'grid'; }
const { project, variant = 'strip' } = Astro.props;
const d = project.data;
const thumb = thumbnailFor(project);
const isVideo = d.kind === 'Video';
const alt = d.youtubeId ? `Video thumbnail: ${d.title}` : d.heroAlt || `${d.title}`;
---
<li class:list={['frame-item', `frame-item--${variant}`]} data-category={filterValue(d.category)}>
  <a href={`/work/${project.id}`} class="frame">
    {variant === 'grid' && <span class="mini-sprockets" aria-hidden="true"></span>}
    <div class="thumb">
      {thumb && <img src={thumb} alt={alt} width="480" height="270" loading="lazy" decoding="async" />}
      <span class="mono tag">{d.kind}</span>
      {isVideo && (
        <svg class="play" width="44" height="44" viewBox="0 0 64 64" fill="none" aria-hidden="true">
          <circle cx="32" cy="32" r="31" stroke="currentColor" stroke-width="2" />
          <path d="M26 21 L44 32 L26 43 Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
        </svg>
      )}
      {!thumb && <span class="mono ph">[ {d.placeholder || 'Media'} ]</span>}
    </div>
    <span class="title">{d.title}</span>
    <span class="mono meta">{d.meta}</span>
  </a>
</li>

<style>
  .frame-item { list-style: none; }
  .frame {
    display: flex;
    flex-direction: column;
    gap: 9px;
    color: var(--paper);
    text-decoration: none;
  }
  .frame:hover { color: var(--paper); }
  .thumb {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--soft-ink);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    overflow: hidden;
  }
  .thumb img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    color: transparent; /* hide alt text if the thumbnail fails to load */
  }
  .ph { color: var(--rule-light); font-size: 11px; } /* #A8A499 is only 3.7:1 on #4A4843 */
  .tag {
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 1;
    font-size: 11px;
    background: var(--paper);
    color: var(--ink);
    padding: 2px 7px;
  }
  .play { position: relative; color: var(--paper); }
  .title { font-weight: 700; font-size: 19px; line-height: 1.2; }
  .meta { font-size: 12px; color: var(--label-ink); }
  .frame:hover .meta, .frame:focus-visible .meta { color: var(--paper); }
  .frame:hover .title { text-decoration: underline; text-decoration-color: var(--accent); text-underline-offset: 4px; }

  /* Grid variant (/work): frames sit on paper, each with a thin sprocket strip on top. */
  .frame-item--grid .frame { color: var(--ink); gap: 0; }
  .frame-item--grid .frame:hover { color: var(--ink); }
  .mini-sprockets {
    display: block;
    height: 14px;
    background-color: var(--ink);
    background-image: linear-gradient(90deg, var(--paper) 0 10px, transparent 10px);
    background-size: 22px 6px;
    background-repeat: repeat-x;
    background-position: 6px center;
  }
  .frame-item--grid .title { margin-top: 12px; }
  .frame-item--grid .meta { margin-top: 6px; color: var(--graphite); }
  .frame-item--grid .frame:hover .meta,
  .frame-item--grid .frame:focus-visible .meta { color: var(--ink); }
</style>
