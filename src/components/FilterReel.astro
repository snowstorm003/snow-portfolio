---
import ProjectFrame from './ProjectFrame.astro';
import { FILTERS, type Project } from '../lib/projects';

interface Props {
  projects: Project[];
  index?: string;          // "01 —"
  title?: string;
  headingLevel?: 'h1' | 'h2';
  showFooterLinks?: boolean;
  headingId?: string;
  variant?: 'strip' | 'grid';
}
const {
  projects,
  index = '01 —',
  title = 'Selected work',
  headingLevel: H = 'h2',
  showFooterLinks = true,
  headingId = 'work-title',
  variant = 'strip',
} = Astro.props;
const total = projects.length;
---
<div class="reel" data-reel>
  <div class="reel-head">
    <H id={headingId} class="section-title"><span class="mono index">{index}</span>{title}</H>
    <p class="mono count" aria-live="polite" aria-atomic="true">
      Showing <span data-count>{total}</span> of {total}
    </p>
  </div>

  <div class="chips" role="group" aria-label="Filter work by category">
    {FILTERS.map((f) => (
      <button type="button" class="chip mono" data-filter={f.value} aria-pressed={f.value === 'all' ? 'true' : 'false'}>
        {f.label}
      </button>
    ))}
  </div>

  {variant === 'strip' ? (
    <div class="strip">
      <div class="sprockets" aria-hidden="true"></div>
      <div class="scroller" data-scroller>
        <ul class="frames" role="list">
          {projects.map((p) => <ProjectFrame project={p} />)}
        </ul>
        <p class="mono empty" data-empty hidden>Nothing on this reel yet.</p>
      </div>
      <div class="sprockets" aria-hidden="true"></div>
    </div>
  ) : (
    <div>
      <ul class="grid" role="list">
        {projects.map((p) => <ProjectFrame project={p} variant="grid" />)}
      </ul>
      <p class="mono empty empty--paper" data-empty hidden>Nothing on this reel yet.</p>
    </div>
  )}

  {showFooterLinks && (
    <div class="mono reel-foot">
      <span aria-hidden="true">Scroll the roll →</span>
      <a href="/work">All work →</a>
    </div>
  )}
</div>

<style>
  .reel-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }
  .count { margin: 0; }

  /* Chips only work with JS, so only show them when JS is present. */
  .chips { display: none; gap: 10px; flex-wrap: wrap; margin-bottom: 22px; }
  :global(.js) .chips { display: flex; }
  .chip {
    min-height: 44px;
    padding: 0 18px;
    background: transparent;
    color: var(--ink);
    border: 1px solid var(--ink);
    cursor: pointer;
    transition: background-color .12s, color .12s, border-color .12s;
  }
  .chip:hover { border-color: var(--accent); }
  .chip[aria-pressed='true'] { background: var(--ink); color: var(--paper); }
  .chip[aria-pressed='true']:hover { border-color: var(--ink); }

  /* ---- Film strip ---- */
  .strip { background: var(--ink); }
  .sprockets {
    height: 22px;
    background-image: linear-gradient(90deg, var(--paper) 0 16px, transparent 16px);
    background-size: 36px 10px;
    background-repeat: repeat-x;
    background-position: 10px center;
  }
  .scroller {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 28px;
    overscroll-behavior-x: contain;
    scrollbar-color: var(--soft-ink) var(--ink);
  }
  .frames {
    display: flex;
    gap: 28px;
    margin: 0;
    padding: 20px 28px 16px;
    width: max-content;
  }
  .frames :global(.frame-item) { flex: none; width: 300px; scroll-snap-align: start; }
  .frames :global(.frame-item[hidden]) { display: none; }
  .empty { color: var(--label-ink); padding: 0 28px 24px; margin: 0; }

  /* ---- Grid (/work) ---- */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 40px 28px;
    margin: 0;
    padding: 0;
  }
  .grid :global(.frame-item[hidden]) { display: none; }
  .empty--paper { color: var(--graphite); padding: 0; }

  .reel-foot {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 4px;
  }
  .reel-foot span { display: inline-flex; align-items: center; min-height: 44px; }
  .reel-foot a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink);
  }
  .reel-foot a:hover { color: var(--accent); }

  @media (max-width: 820px) {
    .frames { gap: 20px; padding-inline: 20px; }
    .frames :global(.frame-item) { width: min(300px, 78vw); }
    .scroller { scroll-padding-inline: 20px; }
    .chips { gap: 8px; }
    .chip { padding: 0 14px; }
  }
</style>

<script>
  const VALID = new Set(['all', 'operations', 'ai', 'events', 'community', 'production']);

  document.querySelectorAll<HTMLElement>('[data-reel]').forEach((reel) => {
    const chips = [...reel.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const items = [...reel.querySelectorAll<HTMLElement>('[data-category]')];
    const count = reel.querySelector('[data-count]');
    const empty = reel.querySelector<HTMLElement>('[data-empty]');
    const scroller = reel.querySelector<HTMLElement>('[data-scroller]');

    const apply = (value: string, updateUrl: boolean) => {
      if (!VALID.has(value)) value = 'all';
      let shown = 0;
      for (const item of items) {
        const match = value === 'all' || item.dataset.category === value;
        item.hidden = !match;
        if (match) shown++;
      }
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.filter === value)));
      if (count) count.textContent = String(shown);
      if (empty) empty.hidden = shown > 0;
      if (scroller) scroller.scrollLeft = 0;

      if (updateUrl) {
        const url = new URL(window.location.href);
        if (value === 'all') url.searchParams.delete('filter');
        else url.searchParams.set('filter', value);
        history.replaceState(history.state, '', url);
      }
    };

    chips.forEach((chip) => chip.addEventListener('click', () => apply(chip.dataset.filter || 'all', true)));

    const initial = new URL(window.location.href).searchParams.get('filter')?.toLowerCase() || 'all';
    apply(initial, false);
  });
</script>
