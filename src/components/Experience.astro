---
import home from '../data/home.json';
import { todoText, todoHtml, SHOW_CV } from '../lib/todos';

const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');
// A credit with no organisation left (TODOs hidden) is dropped rather than shown half-empty.
const rows = home.experience
  .filter((c) => todoText(c.org))
  .map((c) => ({ role: c.role, org: todoHtml(esc(c.org)), dates: todoHtml(esc(c.dates)) }));
// TODO(Snow): replace public/cv.pdf with the real CV — the button hides itself when SHOW_TODOS is false and the CV is still the placeholder.
---
<section id="experience" class="experience wrap" aria-labelledby="experience-title">
  <h2 id="experience-title" class="section-title"><span class="mono index">03 —</span>Experience</h2>

  <ol class="credits" role="list">
    {rows.map((c) => (
      <li class="credit">
        <span class="mono role">{c.role}</span>
        <span class="org-block">
          <span class="org" set:html={c.org} />
          {c.dates && <span class="mono dates" set:html={c.dates} />}
        </span>
      </li>
    ))}
  </ol>

  {SHOW_CV && (
    <div class="cv">
      <a href="/cv.pdf" class="btn btn--outline mono cv-btn" download>Download CV (PDF) ↓</a>
    </div>
  )}
</section>

<style>
  .experience { padding-top: 110px; padding-bottom: 110px; }
  .section-title { text-align: center; margin-bottom: 64px; }
  .credits {
    display: flex;
    flex-direction: column;
    gap: 40px;
    max-width: 900px;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }
  .credit {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 32px;
    align-items: baseline;
  }
  .role { text-align: right; }
  .org-block { display: flex; flex-direction: column; gap: 4px; }
  .org {
    font-weight: 800;
    font-stretch: 75%;
    font-size: 30px;
    line-height: 1.05;
    text-transform: uppercase;
  }
  .cv { display: flex; justify-content: center; margin-top: 56px; }
  .cv-btn { min-height: 48px; padding: 0 28px; }

  @media (max-width: 820px) {
    .experience { padding-top: 80px; padding-bottom: 80px; }
    .section-title { margin-bottom: 48px; }
    .credits { gap: 32px; }
    .credit { grid-template-columns: minmax(0, 1fr); gap: 6px; }
    .role { text-align: left; }
    .org { font-size: 26px; }
  }
</style>
