---
import site from '../data/site.json';

const cells = [
  { label: 'Role', value: site.title, wide: true },
  { label: 'Alias', value: `“${site.alias}”`, accent: true },
  { label: 'Studio', value: site.studio },
  { label: 'Base', value: site.base },
  { label: 'Take', value: '01' },
];
---
<section class="hero wrap" aria-labelledby="hero-name">
  <div class="clapper" aria-hidden="true"></div>
  <div class="slate">
    <div class="cell cell--prod">
      <span class="mono">Prod.</span>
      <h1 id="hero-name" class="display name">{site.name}</h1>
    </div>
    {cells.map((c) => (
      <div class:list={['cell', { 'cell--wide': c.wide }]}>
        <span class="mono">{c.label}</span>
        <p class:list={['value', { 'value--accent': c.accent }]}>{c.value}</p>
      </div>
    ))}
  </div>

  <div class="closing">
    <p class="closing-line">I make complicated things run on time — shoots, events, teams, and lately, the AI workflows behind them.</p>
    <span class="mono sign">— {site.alias}</span>
  </div>
</section>

<style>
  .hero { padding-top: 24px; padding-bottom: 40px; }

  /* The only stripe pattern on the site. */
  .clapper {
    height: 52px;
    border: 2px solid var(--ink);
    border-bottom: none;
    background: repeating-linear-gradient(-45deg, var(--ink) 0 32px, var(--paper) 32px 64px);
  }

  /* 2px ink gaps act as the internal rules, so the grid can reflow freely. */
  .slate {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 2px;
    background: var(--ink);
    border: 2px solid var(--ink);
  }
  .cell {
    background: var(--paper);
    padding: 16px 24px;
    min-width: 0;
  }
  .cell--prod { grid-column: 1 / -1; padding: 18px 24px 26px; }
  .cell--wide { grid-column: span 2; }

  .name {
    margin-top: 6px;
    font-stretch: 66%;
    /* Brief: clamp(52px, 9.4vw, 140px). Capped at 120px: anything larger wraps the
       name inside the 1280px container and pushes the hero past 60–70% of a laptop viewport. */
    font-size: clamp(52px, 9.4vw, 120px);
    line-height: .9;
    letter-spacing: -.01em;
    overflow-wrap: break-word;
  }
  .value {
    margin: 6px 0 0;
    font-weight: 700;
    font-stretch: 85%;
    font-size: 24px;
    line-height: 1.15;
    text-transform: uppercase;
  }
  .value--accent { color: var(--accent); }

  .closing {
    padding: 36px 20px 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    text-align: center;
  }
  .closing-line {
    margin: 0;
    max-width: 40ch;
    font-weight: 300;
    font-size: clamp(20px, 2vw, 28px);
    line-height: 1.45;
    color: var(--soft-ink);
  }
  .sign { color: var(--label-ink); }

  @media (max-width: 820px) {
    .slate { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .cell--wide { grid-column: 1 / -1; }
    .cell, .cell--prod { padding-inline: 16px; }
    .value { font-size: 22px; }
  }
  /* Keep "MUKHOPADHYAY" on one line on small phones (52px floor overflows below ~480px). */
  @media (max-width: 480px) {
    .name { font-size: 11.4vw; }
  }
</style>
